# Virtual Try-On API Configuration
# Copy this file to .env.local and fill in your API keys

# Try360.ai API (https://try360.ai)
TRYON_API_KEY=your_api_key_here
TRYON_API_URL=https://api.try360.ai/v1

# Or use Looksy AI (https://looksyai.in)
# LOOKSY_API_KEY=your_api_key_here
# LOOKSY_API_URL=https://api.looksyai.in/v1

# Or use Perfect Corp API
# PERFECTCORP_API_KEY=your_api_key_here
# PERFECTCORP_API_URL=https://api.perfectcorp.com/v1